# Copy to .env and fill in. Never commit .env.
# Run ./scripts/generate-secrets.sh to get random values for the passwords and keys below.
DB_NAME=kisansetu
DB_USERNAME=kisansetu
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Application secrets: base64 of 32 random bytes each (openssl rand -base64 32). Losing the encryption key
# makes stored Aadhaar and bank account numbers unreadable, so back it up somewhere safe and separate.
APP_ENCRYPTION_KEY=
APP_HMAC_KEY=
APP_JWT_SECRET=

# First admin login, used only while no user exists (password: at least 12 characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SMS / WhatsApp status tracker (Twilio). Leave empty to keep the webhook switched off.
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=

# Production only (docker-compose.prod.yml): the public domain name that points at this server
DOMAIN=
