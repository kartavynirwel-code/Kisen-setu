# TLS reverse proxy. Caddy gets and renews the HTTPS certificate for $DOMAIN automatically
# (the domain's DNS must point at this server and ports 80/443 must be open).
{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	request_body {
		max_size 6MB
	}

	reverse_proxy app:8080
}
